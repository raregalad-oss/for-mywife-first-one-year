<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سنتنا الأولى ❤️</title>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    min-height:100vh;
    overflow:hidden;
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#ffd6e7,#ffe9a8,#d9f8ff);
    display:flex;
    justify-content:center;
    align-items:center;
    color:#7a3154;
}

.heart{
    position:fixed;
    bottom:-40px;
    animation:up 7s linear infinite;
    pointer-events:none;
    opacity:.8;
}

@keyframes up{
    0%{transform:translateY(0) rotate(0);opacity:0}
    15%{opacity:1}
    100%{transform:translateY(-110vh) rotate(360deg);opacity:0}
}

.container{
    text-align:center;
    z-index:5;
}

.title{
    font-size:32px;
    color:#e34f82;
    margin-bottom:35px;
    text-shadow:0 3px 10px #fff;
}

.gift{
    width:240px;
    height:190px;
    position:relative;
    margin:auto;
    cursor:pointer;
    transition:.4s;
    filter:drop-shadow(0 15px 20px rgba(150,60,100,.25));
}

.gift:hover{
    transform:scale(1.07);
}

.box{
    position:absolute;
    bottom:0;
    width:240px;
    height:145px;
    background:#ff719f;
    border-radius:10px;
}

.lid{
    position:absolute;
    top:15px;
    left:-10px;
    width:260px;
    height:55px;
    background:#ff4f89;
    border-radius:10px;
    transition:.8s;
    z-index:4;
}

.ribbon-v{
    position:absolute;
    width:38px;
    height:190px;
    background:#ffd45c;
    left:101px;
    z-index:3;
}

.ribbon-h{
    position:absolute;
    width:260px;
    height:25px;
    background:#ffd45c;
    top:30px;
    left:-10px;
    z-index:5;
}

.bow{
    position:absolute;
    top:-35px;
    left:91px;
    font-size:65px;
    z-index:8;
    transition:.8s;
}

.gift.open .lid{
    transform:translateY(-100px) rotate(-8deg);
}

.gift.open .bow{
    transform:translateY(-100px) rotate(15deg);
}

.card{
    position:absolute;
    width:200px;
    height:130px;
    background:white;
    left:20px;
    bottom:35px;
    border-radius:12px;
    z-index:2;
    transition:1s;
    padding:20px;
    font-size:20px;
}

.gift.open .card{
    transform:translateY(-130px);
}

.hint{
    margin-top:35px;
    font-size:19px;
    color:#d84479;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    50%{transform:scale(1.08)}
}

.message{
    position:fixed;
    inset:0;
    background:linear-gradient(135deg,#ffd6e7,#fff0b5,#d7f7ff);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    opacity:0;
    pointer-events:none;
    transition:1s;
    z-index:20;
}

.message.show{
    opacity:1;
    pointer-events:auto;
}

.paper{
    max-width:700px;
    background:rgba(255,255,255,.94);
    border-radius:30px;
    padding:40px;
    text-align:center;
    box-shadow:0 20px 60px rgba(180,70,120,.25);
    border:5px solid white;
}

.big{
    font-size:65px;
    animation:beat 1s infinite;
}

@keyframes beat{
    50%{transform:scale(1.18)}
}

.paper h1{
    color:#e4497c;
    font-size:42px;
}

.paper p{
    font-size:21px;
    line-height:2;
}

.footer{
    color:#e4497c;
    font-size:25px;
    font-weight:bold;
    margin-top:20px;
}
</style>
</head>

<body>

<div class="container">

    <div class="title">🎉 سنة كاملة من الذكريات ❤️</div>

    <div class="gift" id="gift" onclick="openGift()">

        <div class="card">
            💌<br>
            عندي حاجة ليكي...
        </div>

        <div class="bow">🎀</div>

        <div class="lid"></div>

        <div class="ribbon-h"></div>

        <div class="box"></div>

        <div class="ribbon-v"></div>

    </div>

    <div class="hint">
        اضغطي على الهدية 🎁
    </div>

</div>

<div class="message" id="message">

    <div class="paper">

        <div class="big">❤️</div>

        <h1>سنة كاملة</h1>

        <p>
            النهارده مش يوم عادي...
            <br>
            النهارده كملنا سنة من أجمل الذكريات.
            <br><br>
            سنة فيها ضحك ومواقف وكلام كتير،
            والأجمل إن لسه عندنا ذكريات كتير جاية.
        </p>

        <div class="footer">
            كل سنة وإنتِ جزء جميل من حكايتي ❤️
        </div>

    </div>

</div>

<script>

const emojis=["❤️","💕","💖","💗","💓","✨","🌸"];

function createHeart(){

    const h=document.createElement("div");

    h.className="heart";
    h.innerHTML=emojis[Math.floor(Math.random()*emojis.length)];

    h.style.left=Math.random()*100+"vw";
    h.style.fontSize=(18+Math.random()*25)+"px";
    h.style.animationDuration=(5+Math.random()*5)+"s";

    document.body.appendChild(h);

    setTimeout(()=>h.remove(),10000);
}

setInterval(createHeart,400);

function openGift(){

    document.getElementById("gift").classList.add("open");

    setTimeout(()=>{
        document.getElementById("message").classList.add("show");
    },1000);

}

</script>

</body>
</html>
